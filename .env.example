PORT=8787
DATABASE_PATH=./data/agentloop.db
SESSION_TTL_HOURS=168
WORKSPACE_ROOT=/absolute/path/to/agent-workspace

# Runtime scans this explicit directory for pinned <name>/SKILL.md packages and
# sibling <name>.source.json locks before accepting traffic.
SKILL_DIRECTORY=/absolute/path/to/agentloop/skills

# Package-backed Skills are copied into a managed read-only store under the
# Computer workspace. Imports are accepted only from these server-owned roots.
SKILL_PACKAGE_STORE_ROOT=/absolute/path/to/agent-workspace/.agentloop/skill-packages
SKILL_IMPORT_ROOTS_JSON=["/absolute/path/to/approved-skill-imports"]

# Copy config/llm-providers.example.json to the ignored
# config/llm-providers.json, edit its provider type/endpoint/model, then write
# each matching secret here. Agent and Run APIs cannot submit connection data.
# Set toolChoiceMode to "constrained-as-auto" in the JSON for reasoning-mode
# providers that reject `tool_choice: required` or named function selection.
LLM_PROVIDER_CONFIG_PATH=./config/llm-providers.json
MY_LLM_API_KEY=
TRUSTED_EXECUTABLE_ALIASES_JSON={"artifact-node":"/absolute/path/to/trusted/node"}
# Add ripgrep/grep as a trusted alias to give computer_search_text a native fast
# path instead of the portable JS walk (rg is preferred, grep is the fallback):
# TRUSTED_EXECUTABLE_ALIASES_JSON={"grep":"/usr/bin/grep"}
TRUSTED_COMMAND_ENV_JSON={"RUNTIME_NODE":"/absolute/path/to/trusted/node"}
