# AgentLoop app runtime configuration lives under apps/agentloop-app.
#
# Copy the app-local template instead of creating a monorepo-root .env:
#
#   cp apps/agentloop-app/.env.example apps/agentloop-app/.env
#   cp apps/agentloop-app/config/llm-providers.example.json apps/agentloop-app/config/llm-providers.json
#
# Root npm scripts delegate to the app workspace, whose start script loads
# apps/agentloop-app/.env.
