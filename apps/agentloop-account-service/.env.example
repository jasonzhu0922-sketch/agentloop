# Local development; production must use an HTTPS ingress and a persistent,
# restricted directory. This service owns accounts only, not Router business data.
ACCOUNT_SERVICE_HOST=127.0.0.1
ACCOUNT_SERVICE_PORT=8795
ACCOUNT_SERVICE_DATABASE_DRIVER=sqlite
ACCOUNT_SERVICE_DATABASE_PATH=./data/accounts.db
# Production: an independent database on the production PostgreSQL instance.
# ACCOUNT_SERVICE_DATABASE_DRIVER=postgres
# ACCOUNT_SERVICE_DATABASE_URL=postgresql://agentloop_accounts:URL_ENCODED_PASSWORD@host.docker.internal:5432/agentloop_accounts
# ACCOUNT_SERVICE_DATABASE_POOL_SIZE=5
