# Merge into the device Desktop .env; restart Desktop after changes.
AGENTLOOP_RUNTIME_STATE_BACKEND=sqlite
# Optional native Redis; give each device a unique base namespace.
# AGENTLOOP_RUNTIME_STATE_BACKEND=redis
# AGENTLOOP_RUNTIME_REDIS_URL=redis://127.0.0.1:6379
# AGENTLOOP_RUNTIME_REDIS_NAMESPACE=desktop-device-01
# Requires AOF + appendfsync always + noeviction. Migrate history offline first.
