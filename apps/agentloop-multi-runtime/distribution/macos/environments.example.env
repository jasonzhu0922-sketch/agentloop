# Development defaults to the local multi-runtime launcher.
AGENTLOOP_RELEASE_ENV=development
AGENTLOOP_ROUTER_URL_DEVELOPMENT=http://127.0.0.1:8788
AGENTLOOP_WEB_ORIGIN_DEVELOPMENT=http://127.0.0.1:5174

# Test and production builds must set their fixed service endpoints.
# AGENTLOOP_RELEASE_ENV=test
# AGENTLOOP_ROUTER_URL_TEST=https://router.test.example.com
# AGENTLOOP_WEB_ORIGIN_TEST=https://app.test.example.com

# AGENTLOOP_RELEASE_ENV=production
# AGENTLOOP_ROUTER_URL_PRODUCTION=https://router.example.com
# AGENTLOOP_WEB_ORIGIN_PRODUCTION=https://app.example.com
