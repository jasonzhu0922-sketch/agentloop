# Local Docker Compose configuration. Copy this file to .env.docker before use.
# .env.docker is ignored by Git and may contain machine-specific absolute paths.

# Development-only shared service tokens. Change both values before using a
# shared environment; never commit production credentials here.
RUNTIME_DISPATCH_TOKEN=local-development-dispatch-token-change-me
RUNTIME_ATTACHMENT_TOKEN=local-development-attachment-token-change-me

# Pull the official image through the registry mirror configured in Colima.
# Keep this as node:26-bookworm; do not put the mirror URL in the image name.
NODE_IMAGE=node:26-bookworm
# Optional: set both proxy URLs only when the proxy service is running.
DOCKER_BUILD_HTTP_PROXY=
DOCKER_BUILD_HTTPS_PROXY=
DOCKER_BUILD_NO_PROXY=localhost,127.0.0.1,host.lima.internal
# Alibaba Cloud public npm mirror (npmmirror).
NPM_REGISTRY=https://registry.npmmirror.com

# Storage mode. The default is a single-machine SQLite/WAL demo. For production
# set driver=postgres and inject the URL through your deployment secret store;
# do not use SQLite on an NFS/RWX or multi-node volume.
AGENTLOOP_STATE_DRIVER=sqlite
AGENTLOOP_STATE_SQLITE_PATH=./data/state/agentloop.db
# AGENTLOOP_STATE_DATABASE_URL=postgresql://agentloop:replace-me@db/agentloop
# AGENTLOOP_STATE_POOL_SIZE=10

# The two files owned by this multi-runtime application.
# Replace /Users/zhujun/coding/agentloop if this repository lives elsewhere.
# The Runtime Host environment file supplies variables referenced by provider
# JSON and optional Skill scripts such as enterprise-info. Do not write their
# secret values in this Compose configuration file.
LLM_PROVIDER_CONFIG_FILE=/Users/zhujun/coding/agentloop/apps/agentloop-multi-runtime/config/llm-providers.json
LLM_PROVIDER_ENV_FILE=/Users/zhujun/coding/agentloop/apps/agentloop-multi-runtime/.env

# One physical, shared task workspace mounted by every Runtime Host. The path
# may be a local disk, a pre-mounted NFS volume, or another POSIX filesystem
# that supports concurrent read/write access. It must not be per-runtime.
RUNTIME_WORKSPACE_HOST_PATH=/Users/zhujun/coding/agentloop/apps/agentloop-multi-runtime/data/docker/workspace

# One read-only custom Skill directory is mounted at ./custom-skills in every
# Runtime Host. Its paths are declared by config/skill-directories.json.
CUSTOM_SKILLS_HOST_PATH=/Users/zhujun/coding/agentloop/apps/agentloop-multi-runtime/custom-skills
