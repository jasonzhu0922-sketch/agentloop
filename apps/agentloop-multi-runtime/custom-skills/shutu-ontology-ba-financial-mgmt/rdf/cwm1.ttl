ba:bd_0d84478423ac rdf:type ba:BusinessDomain ;
    rdfs:label "集团财务管理"@zh ;
    rdfs:comment "集团财务管理业务架构技能，用于管理集团财务管理的业务规则、业务流程、业务动作及其对应的 MCP 工具。Invoke when user asks to analyze group finance domain business architecture, identify business rules or business processes, or define MCP tools for group finance domain operations."@zh ;
    ba:source_skill "shutu-ontology-ba-financial-mgmt" ;
    ba:skill_version "0.12.2" .

ba:bp_dc5d395a5778 rdf:type ba:BusinessProcess ;
    rdfs:label "借款管理"@zh ;
    rdfs:comment "银行借款全生命周期核算——合同签订、本金借入、还本付息、利息预提与结转，及对应红冲事项。完整 9 项业财事项见 `docs/业财事项汇总表.md`"@zh .

ba:bp_0b86e2732115 rdf:type ba:BusinessProcess ;
    rdfs:label "资金运作"@zh ;
    rdfs:comment "金融投资运作核算——定期存款、交易账户资金调拨、金融资产（股票/基金/债券等）购入处置与重估、商品/货币衍生品、外汇购汇结汇。完整 21 项业财事项见 `docs/业财事项汇总表.md`"@zh .

ba:bp_19ac7813aafa rdf:type ba:BusinessProcess ;
    rdfs:label "票据管理"@zh ;
    rdfs:comment "应收/应付票据业务核算——收取、兑现、贴现、背书、质押、退票，应付票据出具与承兑，票据保证金。完整 12 项业财事项见 `docs/业财事项汇总表.md`"@zh .

ba:bp_eacec3902983 rdf:type ba:BusinessProcess ;
    rdfs:label "资产管理"@zh ;
    rdfs:comment "长期资产全生命周期核算——固定资产、投资性房地产、无形资产、长期待摊费用、递延收益、使用权资产、租赁负债、长期股权投资的验收/转入、变动、折旧摊销、减值与处置。完整 49 项业财事项见 `docs/业财事项汇总表.md`"@zh .

ba:bp_7e23aac53586 rdf:type ba:BusinessProcess ;
    rdfs:label "成本管理"@zh ;
    rdfs:comment "产品成本核算——辅助生产成本分配、生产成本结转、产品成本计算、待摊费用摊销。完整 4 项业财事项见 `docs/业财事项汇总表.md`"@zh .

ba:bp_7fb64c877118 rdf:type ba:BusinessProcess ;
    rdfs:label "委托贷款"@zh ;
    rdfs:comment "委托贷款业务核算——本金发放与收回、利息计提与收取、减值计提。完整 8 项业财事项见 `docs/业财事项汇总表.md`"@zh .

ba:bp_0eee96fc94a1 rdf:type ba:BusinessProcess ;
    rdfs:label "债券管理"@zh ;
    rdfs:comment "债券融资核算——发行收款、利息计提、付息。完整 3 项业财事项见 `docs/业财事项汇总表.md`"@zh .

ba:bp_0891f16b46b8 rdf:type ba:BusinessProcess ;
    rdfs:label "总账"@zh ;
    rdfs:comment "总账核心核算——费用结转（7/8 归属）、利润结转、开关账、期初切换、账务调整，及税费/暂估/红冲等报账类事项。完整 44 项业财事项见 `docs/业财事项汇总表.md`"@zh .

ba:bp_2655acd153f0 rdf:type ba:BusinessProcess ;
    rdfs:label "财务服务平台"@zh ;
    rdfs:comment "财务服务平台通用手工报账。完整 1 项业财事项见 `docs/业财事项汇总表.md`"@zh .

ba:bp_beae2a73907d rdf:type ba:BusinessProcess ;
    rdfs:label "通宝管理"@zh ;
    rdfs:comment "应收/应付通宝（集团独立结算工具）业务核算——收取、兑现、贴现、背书、出具、承兑。完整 9 项业财事项见 `docs/业财事项汇总表.md`"@zh .

ba:bp_d08a17dba1b4 rdf:type ba:BusinessProcess ;
    rdfs:label "信用证管理"@zh ;
    rdfs:comment "应收/应付信用证业务核算——开立、收取、交单、收款、付款、贴现/福费廷。完整 6 项业财事项见 `docs/业财事项汇总表.md`"@zh .

ba:bp_a5896d7a753e rdf:type ba:BusinessProcess ;
    rdfs:label "资金平台"@zh ;
    rdfs:comment "股份现金平台内部资金核算——平台资金调拨、利息预提与结算。完整 3 项业财事项见 `docs/业财事项汇总表.md`"@zh .

ba:bp_a265f724395d rdf:type ba:BusinessProcess ;
    rdfs:label "应付管理"@zh ;
    rdfs:comment "应付业务全流程核算——预支/预付、采购与费用报支、尾款、付款指令（对公/对私）、出国业务、债务转移、负数发票。完整 23 项业财事项见 `docs/业财事项汇总表.md`"@zh .

ba:bp_7123c7df37b8 rdf:type ba:BusinessProcess ;
    rdfs:label "薪酬核算"@zh ;
    rdfs:comment "职工薪酬发放核算。完整 1 项业财事项见 `docs/业财事项汇总表.md`"@zh .

ba:bp_c71b6d4517e4 rdf:type ba:BusinessProcess ;
    rdfs:label "在建工程"@zh ;
    rdfs:comment "在建工程核算——暂估与转固。完整 2 项业财事项见 `docs/业财事项汇总表.md`"@zh .

ba:bp_13144521d67f rdf:type ba:BusinessProcess ;
    rdfs:label "库存核算"@zh ;
    rdfs:comment "存货收发存核算——期初切换、各类出入库、减值准备、业财对账。完整 25 项业财事项见 `docs/业财事项汇总表.md`"@zh .

ba:bp_fae7d192b086 rdf:type ba:BusinessProcess ;
    rdfs:label "应收管理"@zh ;
    rdfs:comment "应收业务核算——销售收款与核销、退款转款、销售结算（外销）、暂估与预计。完整 15 项业财事项见 `docs/业财事项汇总表.md`"@zh .

ba:bp_d49ad0454252 rdf:type ba:BusinessProcess ;
    rdfs:label "现金管理"@zh ;
    rdfs:comment "银行间划款核算。完整 1 项业财事项见 `docs/业财事项汇总表.md`"@zh .

