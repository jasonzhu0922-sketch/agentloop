# TiDB-only override file. Copy to .env.docker.tidb and keep it out of Git.
# Database user passwords are URL-encoded; use the secret store in shared environments.
AGENTLOOP_ROUTER_STATE_DRIVER=tidb
AGENTLOOP_ROUTER_STATE_DATABASE_URL=mysql://agentloop:replace-me@tidb.example:4000/agentloop_router
AGENTLOOP_ROUTER_STATE_POOL_SIZE=10
AGENTLOOP_RUNTIME_STATE_DRIVER=tidb
AGENTLOOP_RUNTIME_STATE_DATABASE_URL=mysql://agentloop:replace-me@tidb.example:4000/agentloop_runtime
AGENTLOOP_RUNTIME_STATE_POOL_SIZE=10
