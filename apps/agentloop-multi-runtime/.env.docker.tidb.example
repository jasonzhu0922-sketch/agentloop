# TiDB-only override file. Copy to .env.docker.tidb and keep it out of Git.
# Database user passwords are URL-encoded; use the secret store in shared environments.
AGENTLOOP_ROUTER_STATE_DRIVER=tidb
AGENTLOOP_ROUTER_STATE_DATABASE_URL=mysql://agentloop:replace-me@tidb.example:4000/agentloop_router
AGENTLOOP_ROUTER_STATE_POOL_SIZE=10

# Runtime execution is separate from Router SQL. Migrate old SQL history offline.
AGENTLOOP_RUNTIME_STATE_BACKEND=redis
AGENTLOOP_RUNTIME_REDIS_URL=redis://runtime-redis:6379
AGENTLOOP_RUNTIME_REDIS_NAMESPACE=agentloop-runtime-state
# Optional background summary projection only:
# Redis Runtime history (required). Old RUNTIME_SUMMARY_TIDB_URL is a history-only alias.
RUNTIME_HISTORY_TIDB_URL=mysql://user:password@tidb.example:4000/runtime_history
