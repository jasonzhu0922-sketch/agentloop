# Device-local Local Runtime Agent configuration.
# Copy this file to .env in the same directory and keep the real file out of source control.
# Model and web-search values are consumed only in the Local Agent process;
# Skill integrations receive this file path, never the values, and the model never sees them.

# The current default provider is `openai`; configure exactly the provider(s)
# enabled in config/llm-providers.json.
OPENAI_API_KEY=
# MY_LLM_API_KEY=

# Optional: enable only when local Runs should use web search.
WEB_SEARCH_ENDPOINT=https://api.bochaai.com/v1/web-search
WEB_SEARCH_API_KEY=

# Optional: set to 1 to disable web search for this Local Agent.
# WEB_SEARCH_DISABLED=1

# mysql-steel-data Skill configuration.
STEEL_MARKET_DB_HOST=127.0.0.1
STEEL_MARKET_DB_PORT=3306
STEEL_MARKET_DB_NAME=test
STEEL_MARKET_DB_USER=readonly_steel_market
STEEL_MARKET_DB_PASSWORD=
