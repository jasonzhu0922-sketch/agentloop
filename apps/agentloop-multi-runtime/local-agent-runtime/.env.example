# Device-local Local Runtime Agent configuration.
# Copy this file to .env in the same directory and keep the real file out of source control.
# Model and web-search values are consumed only in the Local Agent process;
# Skill integrations receive this file path, never the values, and the model never sees them.

# The current default provider is `openai`; configure exactly the provider(s)
# enabled in config/llm-providers.json.
OPENAI_API_KEY=
# MY_LLM_API_KEY=

# Bounded OutcomePlan contract-repair attempts for each local Run (default: 8; max: 64).
# This does not increase execution-step tool-call limits.
# PLANNING_MAX_TURNS=8
# Bounded model turns for each executable Plan step (default: 64; max: 256).
# Tool-call ceilings and file-output convergence grace remain separate safeguards.
# STEP_MAX_TURNS=64

# Optional: enable only when local Runs should use web search.
WEB_SEARCH_ENDPOINT=https://api.bochaai.com/v1/web-search
WEB_SEARCH_API_KEY=

# AMap MCP is enabled by the device-owned mcp-servers.json. Its key is read
# only by the Local Agent MCP loader and is never passed to the Router or model.
AMAP_MCP_KEY=

# OntoFlow JTBC MCP is opt-in. Copy the reviewed server entry from
# ../../config/mcp-servers.shutu.example.json into this device's owned
# config/mcp-servers.json; keep the API key only in this private file.
ONTOFLOW_JTBC_API_KEY=

# 金山文档/WPS OAuth（由部署者在 WPS 开放平台创建应用后配置）。
# 回调地址必须与 WPS 开放平台登记的一致，例如：
# http://127.0.0.1:18790/v1/local-connectors/kingsoft-wps/callback
# WPS_OAUTH_CLIENT_ID=
# WPS_OAUTH_CLIENT_SECRET=
# WPS_OAUTH_REDIRECT_URI=http://127.0.0.1:18790/v1/local-connectors/kingsoft-wps/callback
# 个人/第三方应用使用该应用权限目录中实际可申请的用户级 REST 权限；获批后再启用。
# WPS_OAUTH_SCOPES=kso.file.read,kso.file_search.readwrite

# data-platform-query reads settings from its own Skill root .env.

# Optional: set to 1 to disable web search for this Local Agent.
# WEB_SEARCH_DISABLED=1

# mysql-steel-data reads database settings from its own Skill root .env.
