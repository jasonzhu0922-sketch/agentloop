{
  "defaultProvider": "openai",
  "defaultModelKey": "gpt-5.6-terra",
  "providers": {
    "openai": {
      "kind": "openai-compatible",
      "baseUrl": "https://api.openai.com/v1",
      "apiKeyEnv": "OPENAI_API_KEY",
      "defaultModel": "gpt-5.6-terra",
      "contextWindowTokens": 400000,
      "maxOutputTokens": 32768,
      "timeoutMs": 180000,
      "maxAttempts": 3,
      "retryDelayMs": 250,
      "toolChoiceMode": "native",
      "runtimeContextPlacement": "system",
      "reasoningSummary": "auto",
      "protocol": "responses"
    },
    "my-provider": {
      "kind": "openai-compatible",
      "baseUrl": "http://api.deepseek.com/v1",
      "protocol": "chat-completions",
      "apiKeyEnv": "MY_LLM_API_KEY",
      "defaultModel": "deepseek-v4-pro",
      "contextWindowTokens": 128000,
      "maxOutputTokens": 16384,
      "timeoutMs": 300000,
      "maxAttempts": 3,
      "retryDelayMs": 250,
      "toolChoiceMode": "constrained-as-auto"
    }
  },
  "models": {
    "gpt-5.6-terra": {
      "providerKey": "openai",
      "providerModel": "gpt-5.6-terra",
      "displayName": "GPT-5.6 Terra",
      "protocol": "responses",
      "reasoningEffort": "none"
    },
    "deepseek-v4-pro": {
      "providerKey": "my-provider",
      "providerModel": "deepseek-v4-pro",
      "displayName": "DeepSeek v4 Pro",
      "maxOutputTokens": 16384,
      "thinkingMode": "enabled",
      "thinkingEffort": "medium",
      "reasoningVisibility": "hidden"
    },
    "deepseek-v4-flash": {
      "providerKey": "my-provider",
      "providerModel": "deepseek-v4-flash",
      "displayName": "DeepSeek v4 Flash",
      "maxOutputTokens": 16384,
      "toolChoiceMode": "named-as-required",
      "thinkingMode": "enabled",
      "thinkingEffort": "medium",
      "reasoningVisibility": "hidden"
    },
    "deepseek-v4-flash-local": {
      "providerKey": "my-provider",
      "providerModel": "DeepSeek-V4-flash",
      "displayName": "DeepSeek v4 Flash Local",
      "chatTemplateKwargs": {
        "thinking": true
      },
      "reasoningVisibility": "hidden"
    }
  }
}
