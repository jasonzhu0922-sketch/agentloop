# Router. Use a distinct high-entropy value for each secret in a real deployment.
PORT=8788
HOST=127.0.0.1
WEB_ORIGIN=http://127.0.0.1:5174
ATTACHMENT_BASE_URL=http://127.0.0.1:8788
# One state store is shared by Router and every Runtime Host.
# local: one SQLite/WAL file on a single machine; do not place it on NFS/RWX.
AGENTLOOP_STATE_DRIVER=sqlite
AGENTLOOP_STATE_SQLITE_PATH=./data/local/agentloop.db
# production: set AGENTLOOP_STATE_DRIVER=postgres and inject this value from
# the deployment secret store.  Do not commit a real connection string.
# AGENTLOOP_STATE_DATABASE_URL=postgresql://agentloop:replace-me@db/agentloop
# AGENTLOOP_STATE_POOL_SIZE=10
RUNTIME_HEARTBEAT_TTL_MS=15000
RUNTIME_RESERVATION_TTL_MS=30000
RUNTIME_DISPATCH_TOKEN=replace-with-at-least-16-characters
RUNTIME_ATTACHMENT_TOKEN=replace-with-at-least-16-characters

# Runtime Host. Start each Host with an instance-specific environment.
# RUNTIME_ID=general-01
# PORT=8791
# ROUTER_URL=http://127.0.0.1:8788
# MAX_CONCURRENT_RUNS=2
# HEARTBEAT_INTERVAL_MS=5000
# LLM_PROVIDER_CONFIG_PATH=./config/llm-providers.json
# STEP_EXECUTION_STRATEGY_CONFIG_PATH=./config/step-execution-strategy.json
# Application-owned config whose customSkillDirectories are merged with the
# bundled @zhujun/agentloop-skills catalog by every Runtime Host.
# SKILL_DIRECTORIES_CONFIG_PATH=./config/skill-directories.json
# LLM_PROVIDER_ENV_FILE=./.env
# Provider and integration credentials. Keep real values only in this ignored
# file or inject them through the deployment secret store.
OPENAI_API_KEY=
MY_LLM_API_KEY=
WEB_SEARCH_API_KEY=
AMAP_MCP_KEY=
# Optional Enterprise Info Skill configuration. The Skill-owned script reads
# these three values from this deployment-owned ignored file. They are never
# copied into the Skill package or command environment.
ENTERPRISE_INFO_API_BASE_URL=
ENTERPRISE_INFO_API_CLIENT_ID=
ENTERPRISE_INFO_API_CLIENT_SECRET=
# Optional path to the deployment-owned file read by the Skill script. This
# value is a path only; never place credentials in ENTERPRISE_INFO_ENV_FILE.
# ENTERPRISE_INFO_ENV_FILE=./.env
# Optional path to the deployment-owned MySQL configuration read by the
# mysql-steel-data Skill. This value is a path only; never put credentials in
# the Runtime command environment.
# STEEL_MARKET_DB_ENV_FILE=./.env
# MySQL Steel Market Skill configuration. Place real values only in the
# ignored deployment file referenced above; grant the configured user SELECT
# access only to the intended schema.
STEEL_MARKET_DB_HOST=127.0.0.1
STEEL_MARKET_DB_PORT=3306
STEEL_MARKET_DB_NAME=test
STEEL_MARKET_DB_USER=
STEEL_MARKET_DB_PASSWORD=
# WORKSPACE_ROOT=./workspace
# Every Runtime Host must mount this same physical location. RunService isolates
# task files below conversations/<conversationId>.  It remains a shared POSIX
# workspace and is not replaced by object storage.
# SKILL_PACKAGE_STORE_ROOT=./data/general-01/skill-packages
