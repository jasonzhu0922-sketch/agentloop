# Admin database. Use postgresql:// for production, mysql:// for TiDB, or set
# AGENTLOOP_ADMIN_DATABASE_PATH for local SQLite. Do not copy real credentials into Git.
AGENTLOOP_ADMIN_DATABASE_URL=mysql://user:password@127.0.0.1:4000/agentloop_admin
# AGENTLOOP_ADMIN_DATABASE_PATH=./data/admin.db

# Used only by provision:admin-database; omit the database path.
AGENTLOOP_ADMIN_SERVER_URL=mysql://user:password@127.0.0.1:4000
AGENTLOOP_ADMIN_DATABASE_NAME=agentloop_admin

ADMIN_API_PORT=8892
CONTROL_PLANE_SNAPSHOT_TTL_MS=60000
# Provider/model state is Router-owned. Admin API never seeds cp_releases for
# model and operations routes; configure ADMIN_ROUTER_URL and the shared
# RUNTIME_DISPATCH_TOKEN below.
# Admin API-local read-only custom Skill source. Do not use the Compose host mount variable here.
ADMIN_CUSTOM_SKILLS_PATH=./custom-skills

# Router internal read-only operations projection. Keep the token server-side.
ADMIN_ROUTER_URL=http://127.0.0.1:8788
RUNTIME_DISPATCH_TOKEN=development-dispatch-token-123

# Keep deny-all until an explicit local Admin token is configured.
ADMIN_AUTH_MODE=deny
# Interactive local Admin login. Generate the hash with:
# printf '%s' 'a-local-password-at-least-12-chars' | npm run hash:admin-password
# ADMIN_AUTH_MODE=password
# ADMIN_AUTH_USERNAME=admin
# ADMIN_AUTH_PASSWORD_HASH=scrypt$16384$8$1$...
# ADMIN_AUTH_MODE=static
# ADMIN_AUTH_TOKEN=replace-with-a-local-only-token
# ADMIN_AUTH_ROLE=platform_admin
# ADMIN_AUTH_ACTOR_ID=bootstrap-admin
# ADMIN_AUTH_SCOPE_ID=platform
# ADMIN_AUTH_DISPLAY_NAME=Platform Admin
