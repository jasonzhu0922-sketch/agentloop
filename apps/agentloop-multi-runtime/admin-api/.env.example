# Admin-only TiDB connection. Do not copy real credentials into Git.
AGENTLOOP_ADMIN_DATABASE_URL=mysql://user:password@127.0.0.1:4000/agentloop_admin

# Used only by provision:admin-database; omit the database path.
AGENTLOOP_ADMIN_SERVER_URL=mysql://user:password@127.0.0.1:4000
AGENTLOOP_ADMIN_DATABASE_NAME=agentloop_admin

ADMIN_API_PORT=8792
CONTROL_PLANE_SNAPSHOT_TTL_MS=60000

# Keep deny-all until an explicit local Admin token is configured.
ADMIN_AUTH_MODE=deny
# ADMIN_AUTH_MODE=static
# ADMIN_AUTH_TOKEN=replace-with-a-local-only-token
# ADMIN_AUTH_ROLE=platform_admin
# ADMIN_AUTH_ACTOR_ID=bootstrap-admin
# ADMIN_AUTH_SCOPE_ID=platform
