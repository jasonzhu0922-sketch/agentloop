# Runtime Host secrets only. This file is mounted with Compose `env_file` into
# the two Runtime Host containers; Router and Web never receive these values.
# Copy it to <DEPLOY_ROOT>/secrets/runtime.env, set mode 600, then replace only
# variables referenced by config/llm-providers.json or your enabled Skills.

OPENAI_API_KEY=replace-at-deploy
# MY_LLM_API_KEY=replace-at-deploy
# AMAP_MCP_KEY=replace-at-deploy
# API_QUERY_API_URL=https://replace-at-deploy
# EPLAT_CLIENT_ID=replace-at-deploy
# EPLAT_CLIENT_SECRET=replace-at-deploy
