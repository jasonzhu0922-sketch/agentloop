# This file is materialized as <DEPLOY_ROOT>/.env by deploy.sh init.
# It contains deployment-scoped secrets: mode 600 and never commit it.

# Immutable tag loaded with `deploy.sh load-image` or built with `deploy.sh build`.
MULTI_RUNTIME_IMAGE=agentloop-multi-runtime:centos7

# The Local Runtime Agent receives PUBLIC_ROUTER_URL from the browser and
# connects to it directly. For a formal deployment both URLs should be HTTPS;
# a reverse proxy may use one origin and route /v1 plus /healthz to Router.
PUBLIC_WEB_ORIGIN=http://SERVER_IP:3001
PUBLIC_ROUTER_URL=http://SERVER_IP:5001
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=3001
# Browser-device installed Agent; development uses 8790 on the same device.
LOCAL_AGENT_URL=http://127.0.0.1:18790
# Router has its own public protocol port for browser-independent API clients
# and Local Runtime Agent HTTP/WebSocket control connections.
ROUTER_BIND_ADDRESS=0.0.0.0
ROUTER_PORT=5001

# Generated by deploy.sh init. Keep both non-empty and private.
RUNTIME_DISPATCH_TOKEN=replace-with-a-long-random-value
RUNTIME_ATTACHMENT_TOKEN=replace-with-a-long-random-value

# Absolute, server-local paths generated by deploy.sh init.
DEPLOY_ROOT=/opt/agentloop
# Local Agent downloads live outside the image under DEPLOY_ROOT/downloads/.
# Catalog: downloads/catalog/releases.json; installer bytes: downloads/installers/.
RUNTIME_ENV_FILE=/opt/agentloop/secrets/runtime.env
LLM_PROVIDER_CONFIG_FILE=/opt/agentloop/config/llm-providers.json
MCP_SERVERS_CONFIG_FILE=/opt/agentloop/config/mcp-servers.json
CUSTOM_SKILLS_HOST_PATH=/opt/agentloop/config/custom-skills
RUNTIME_WORKSPACE_HOST_PATH=/opt/agentloop/data/workspace

# A single CentOS host may use SQLite only on its local Docker volume.
# Do not put SQLite on NFS/RWX and do not use it after adding a second host.
AGENTLOOP_STATE_DRIVER=sqlite
AGENTLOOP_STATE_SQLITE_PATH=./data/state/agentloop.db

# For PostgreSQL/TiDB set Router and Runtime independently. Database passwords
# belong in this mode-600 file, URL-encoded where required.
# A PostgreSQL process on this CentOS host must use `host.docker.internal`,
# never 127.0.0.1: from a container that address means the container itself.
# The Compose file maps that name to Docker's host gateway.
# AGENTLOOP_ROUTER_STATE_DRIVER=postgres
# AGENTLOOP_ROUTER_STATE_DATABASE_URL=postgresql://agentloop:URL_ENCODED_PASSWORD@host.docker.internal:5432/agentloop_router
# AGENTLOOP_RUNTIME_STATE_DRIVER=postgres
# AGENTLOOP_RUNTIME_STATE_DATABASE_URL=postgresql://agentloop:URL_ENCODED_PASSWORD@host.docker.internal:5432/agentloop_runtime
# AGENTLOOP_ROUTER_STATE_DRIVER=tidb
# AGENTLOOP_ROUTER_STATE_DATABASE_URL=mysql://agentloop:password@tidb.example:4000/agentloop_router
# AGENTLOOP_RUNTIME_STATE_DRIVER=tidb
# AGENTLOOP_RUNTIME_STATE_DATABASE_URL=mysql://agentloop:password@tidb.example:4000/agentloop_runtime

# Cloud Runtime instances, integer 1..256. deploy.sh up renders services + Router catalog.
RUNTIME_COUNT=2
# Concurrent Runs per Runtime; this does not change the number of Node processes.
MAX_CONCURRENT_RUNS=20
PLANNING_MAX_TURNS=4
STEP_MAX_TURNS=32
HEARTBEAT_INTERVAL_MS=1000
AGENTLOOP_LOG_COLOR=never
