PORT=8787
# Bind host for the API. Use 0.0.0.0 to expose the API beyond localhost.
HOST=127.0.0.1
# Comma-free JSON array of browser origins allowed to call the API
# cross-origin (CORS). The dev script fills this automatically.
WEB_ORIGINS_JSON=[]
DATABASE_PATH=./data/agentloop.db
SESSION_TTL_HOURS=168
WORKSPACE_ROOT=./workspace

# Runtime scans kernel Skills plus explicitly configured extension roots.
CUSTOM_SKILL_DIRECTORIES_JSON=["./custom-skills"]

# Package-backed Skills are copied into a managed read-only store under WORKSPACE_ROOT.
# Imports are accepted only from these server-owned roots.
# Optional. Keep empty unless you have real server-owned import roots.
SKILL_IMPORT_ROOTS_JSON=[]

# Copy config/llm-providers.example.json to the ignored config/llm-providers.json,
# edit its provider type/endpoint/model, then write each matching secret here.
# Agent and Run APIs cannot submit connection data.
LLM_PROVIDER_CONFIG_PATH=./config/llm-providers.json
MY_LLM_API_KEY=
OPENAI_API_KEY=

# Optional. Keep empty unless you have real trusted executables to expose.
TRUSTED_EXECUTABLE_ALIASES_JSON={}
# Add ripgrep/grep as a trusted alias to give computer_search_text a native fast
# path instead of the portable JS walk (rg is preferred, grep is the fallback):
# TRUSTED_EXECUTABLE_ALIASES_JSON={"grep":"/usr/bin/grep"}
TRUSTED_COMMAND_ENV_JSON={}

# Web tools: websearch defaults to the Baidu backend, which is appropriate for
# deployments inside mainland China. "bing" switches to the Bing RSS feed.
# To use a JSON search API instead (Tavily, Brave, or a self-hosted SearXNG
# proxy), set WEB_SEARCH_ENDPOINT and optionally WEB_SEARCH_API_KEY.
# WEB_SEARCH_PROVIDER=baidu
# WEB_SEARCH_ENDPOINT=https://your-search-api.example/search
# WEB_SEARCH_API_KEY=
