DATA_AGENT_PORT=8810
DATA_AGENT_PYTHON=python3
# Paths relative to this app, or absolute paths. Credentials stay server-side.
DATA_AGENT_MODEL_CONFIG=config/llm-providers.json
# Runtime execution state. Redis must enable AOF + appendfsync always + noeviction.
DATA_AGENT_STATE_BACKEND=redis
DATA_AGENT_REDIS_URL=redis://127.0.0.1:6379
# DATA_AGENT_REDIS_STATE_PREFIX=data-agent:{deployment}
# Stable and unique among simultaneously running hosts.
DATA_AGENT_RUNTIME_ID=data-agent-01
# SQLite alternative: DATA_AGENT_STATE_BACKEND=sqlite
# DATA_AGENT_SQLITE_FILE=data/files/runtime.sqlite
# Required for Redis history; never used for execution state.
DATA_AGENT_HISTORY_TIDB_URL=mysql://user:password@127.0.0.1:4000/runtime_history
# Large query results and execution attachments stay on disk.
DATA_AGENT_FILE_DIR=data/files
# Optional explicit model from the configured registry. Otherwise its default.
# DATA_AGENT_MODEL_KEY=
# Maximum Planner contract-repair turns for one Run (1..64).
# PLANNING_MAX_TURNS=4
# Maximum model turns for each executable Plan step (1..256).
# STEP_MAX_TURNS=32

# History precedence: HISTORY_TIDB_URL > RUNTIME_SUMMARY_TIDB_URL > TIDB_URL.
# These connections are separate from Skill catalogue/query databases.
DATA_AGENT_HISTORY_CONNECTION_LIMIT=2
DATA_AGENT_HISTORY_TIMEOUT_MS=3000
DATA_AGENT_HISTORY_BATCH_SIZE=100
DATA_AGENT_HISTORY_INTERVAL_MS=1000
DATA_AGENT_HISTORY_RETRY_BASE_MS=1000
DATA_AGENT_HISTORY_RETRY_MAX_MS=60000
