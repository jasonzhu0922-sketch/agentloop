DATA_AGENT_PORT=8810
DATA_AGENT_PYTHON=python3
# Paths relative to this app, or absolute paths. Credentials stay server-side.
DATA_AGENT_MODEL_CONFIG=config/llm-providers.json
# A dedicated, existing TiDB database for conversations, Runs, plans and events.
DATA_AGENT_TIDB_URL=mysql://user:password@127.0.0.1:4000/agentloop_data_agent
# Large query results and execution attachments stay on disk.
DATA_AGENT_FILE_DIR=data/files
# Optional explicit model from the configured registry. Otherwise its default.
# DATA_AGENT_MODEL_KEY=
# Maximum Planner contract-repair turns for one Run (1..64).
# PLANNING_MAX_TURNS=4
# Maximum model turns for each executable Plan step (1..256).
# STEP_MAX_TURNS=32
