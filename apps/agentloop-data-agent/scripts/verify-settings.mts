import assert from 'node:assert/strict';
import { randomUUID } from 'node:crypto';
import { cp, mkdtemp, mkdir, readFile, writeFile, rm } from 'node:fs/promises';
import { tmpdir } from 'node:os';
import { join, resolve } from 'node:path';
import { once } from 'node:events';
import { execFileSync } from 'node:child_process';
import type { AddressInfo } from 'node:net';
import mysql from 'mysql2/promise';
import { chromium } from 'playwright-core';
import { removeSkillPackage } from '@zhujun/agentloop';
import { createDataAgent } from '../src/agent.ts';
import { createChatServer } from '../src/server.ts';
import { connectState } from '../src/tidb-state.ts';
import { ModelSettings } from '../src/model-settings.ts';
import { SettingsService } from '../src/settings.ts';

const appRoot = resolve(import.meta.dirname, '..');
const python = process.env.DATA_AGENT_PYTHON ?? 'python3';
const root = await mkdtemp(join(tmpdir(), 'data-agent-settings-'));
const output = join(appRoot, 'data/qa/settings');
await mkdir(output, { recursive: true });
const url = new URL(process.env.DATA_AGENT_TIDB_URL!);
const admin = await mysql.createConnection({ host: url.hostname, port: Number(url.port || 4000), user: decodeURIComponent(url.username), password: decodeURIComponent(url.password) });
const schema = `data_agent_settings_test_${randomUUID().replaceAll('-', '')}`;
let agent: Awaited<ReturnType<typeof createDataAgent>> | undefined;
let server: ReturnType<typeof createChatServer> | undefined;
let browser: Awaited<ReturnType<typeof chromium.launch>> | undefined;
try {
  await admin.query(`CREATE DATABASE \`${schema}\` CHARACTER SET utf8mb4 COLLATE utf8mb4_bin`);
  await admin.query(`CREATE TABLE \`${schema}\`.scenarios (id VARCHAR(64) PRIMARY KEY, name VARCHAR(255), description TEXT, config JSON, created_at DATETIME DEFAULT CURRENT_TIMESTAMP)`);
  const skillRoot = join(root, 'data-analysis');
  await cp(join(appRoot, 'skills/data-analysis'), skillRoot, { recursive: true });
  const connections = JSON.parse(await readFile(join(skillRoot, 'connections.json'), 'utf8'));
  const originalModels = await new ModelSettings(resolve(appRoot, process.env.DATA_AGENT_MODEL_CONFIG ?? 'config/llm-providers.json')).load();
  const originalSettings = new SettingsService(originalModels, { python, script: join(appRoot, 'scripts/manage_catalog.py'), skillRoot: join(appRoot, 'skills/data-analysis') });
  const originalCatalog = await originalSettings.catalog('load');
  const { revision, ...config } = originalCatalog;
  await admin.query(`INSERT INTO \`${schema}\`.scenarios(id,name,description,config) VALUES ('group','集团经营分析','隔离配置回归',?)`, [JSON.stringify(config)]);
  const catalogUrl = new URL(connections.catalog_database_url); catalogUrl.pathname = `/${schema}`;
  connections.catalog_database_url = catalogUrl.toString();
  await writeFile(join(skillRoot, 'connections.json'), JSON.stringify(connections), { mode: 0o600 });
  const modelPath = join(root, 'models.json');
  await cp(originalModels.path, modelPath);
  const models = await new ModelSettings(modelPath).load();
  const settings = new SettingsService(models, { python, script: join(appRoot, 'scripts/manage_catalog.py'), skillRoot });
  const state = new URL(url); state.pathname = `/${schema}`;
  agent = await createDataAgent({ connection: await connectState(state.toString()), fileDirectory: join(root, 'files'), skillRoot, python,
    modelKeys: models.registry.modelKeys(), defaultModelKey: models.defaultModelKey, modelFactory: (retry, key) => models.registry.create(key, retry) });
  server = createChatServer(agent, { webRoot: join(appRoot, 'web'), models: models.registry.modelCatalog(), defaultModelKey: models.defaultModelKey, settings });
  server.listen(0, '127.0.0.1'); await once(server, 'listening');
  const origin = `http://127.0.0.1:${(server.address() as AddressInfo).port}`;
  browser = await chromium.launch({ executablePath: process.env.DATA_AGENT_CHROME ?? '/Applications/Google Chrome.app/Contents/MacOS/Google Chrome', headless: true });
  const page = await browser.newPage({ viewport: { width: 1440, height: 1100 } });
  const errors: string[] = [];
  page.on('pageerror', error => errors.push(error.message));
  await page.goto(`${origin}/settings#model`);
  await page.locator('#model-form').waitFor();
  assert.equal(await page.locator('[id*="scenario"], [name="scenario_id"]').count(), 0);
  assert.equal(await page.locator('#model-form input[type=password]').inputValue(), '');
  await page.screenshot({ path: join(output, 'model-desktop.png'), fullPage: true });
  const savedModel = page.waitForResponse(r => r.url().endsWith('/api/settings/models') && r.request().method() === 'PUT');
  await page.locator('#model-form button[type=submit]').click();
  assert.equal((await savedModel).status(), 200);
  await page.locator('#model-form').waitFor();
  for (const panel of ['connection', 'server', 'workflow', 'tables', 'metrics', 'terms', 'skills', 'sample_questions', 'semantic_objects', 'relationships', 'period_formats', 'semantic_gaps']) {
    await page.locator(`[data-panel="${panel}"]`).click();
    await page.waitForFunction(() => document.querySelector('#knowledge-panel')?.getAttribute('aria-busy') === 'false');
    assert.equal(await page.locator('#reload-panel').count(), 0, panel);
  }
  await page.locator('[data-panel="semantic_objects"]').click();
  await page.locator('.semantic-layer-summary').waitFor();
  assert.ok(await page.locator('.semantic-layer-summary .semantic-layer-chip').count() > 0, 'semantic object summary is visible');
  assert.ok(await page.locator('.semantic-layer-summary .semantic-layer-chip').count() > 0, 'semantic layer summary is visible');
  await page.locator('.semantic-layer-chip[data-layer-panel="terms"]').click();
  await page.waitForFunction(() => document.querySelector('#knowledge-panel h2')?.textContent === '业务术语');
  await page.locator('[data-panel="semantic_objects"]').click();
  await page.locator('.semantic-layer-summary').waitFor();
  await page.locator('#add-record').click();
  await page.locator('#editor-form [name=label]').fill('设置回归对象');
  await page.locator('#editor-form [name=source_id]').selectOption(config.tables[0].name);
  const firstColumn = config.tables[0].columns[0].name;
  await page.locator('#editor-form [name=key_field]').selectOption(firstColumn);
  await page.locator('#editor-form [name=name_fields]').selectOption(firstColumn);
  const savedEntity = page.waitForResponse(r => r.url().endsWith('/api/settings/catalog') && r.request().method() === 'PUT');
  await page.locator('#editor-form button[type=submit]').click();
  assert.equal((await savedEntity).status(), 200);
  await page.locator('#editor-dialog').waitFor({ state: 'hidden' });
  assert.ok(await page.getByText('设置回归对象', { exact: true }).count() > 0, 'human object definition is saved');
  await page.locator('[data-panel="terms"]').click();
  await page.locator('#add-record').waitFor();
  await page.locator('#add-record').click();
  await page.locator('#editor-form [name=term]').fill('配置回归测试词');
  await page.locator('#editor-form [name=source_id]').selectOption(config.tables[0].name);
  await page.locator('#editor-form [name=aliases]').fill('配置测试别名');
  await page.locator('#editor-form [name=meaning]').fill(`这是配置回归测试词，关联 ${config.tables[0].name}，仅存在于隔离测试库。`);
  await page.locator('#editor-form [name=evidence_ids]').fill('settings:e2e');
  const savedTerm = page.waitForResponse(r => r.url().endsWith('/api/settings/catalog') && r.request().method() === 'PUT');
  await page.locator('#editor-form button[type=submit]').click();
  assert.equal((await savedTerm).status(), 200);
  await page.locator('#editor-dialog').waitFor({ state: 'hidden' });
  await page.reload();
  await page.getByText('配置回归测试词', { exact: true }).waitFor();
  const readback = JSON.parse(execFileSync(python, ['-c', 'import sys,json;sys.path.insert(0,sys.argv[1]+"/scripts");from data_access import load_gateway;v=load_gateway().catalog("group",question="配置回归测试词");print(json.dumps({"terms":v["terms"]},ensure_ascii=False))', skillRoot], { encoding: 'utf8' }));
  assert.ok(readback.terms.some((term: { term: string }) => term.term === '配置回归测试词'), 'Skill reads the saved definition');
  const saved = await settings.catalog('load');
  await assert.rejects(settings.catalog('save', { revision: originalCatalog.revision, changes: { terms: [] } }), /更新/);
  assert.ok(saved.terms.some((term: { term: string }) => term.term === '配置回归测试词'));
  const projectedTerm = saved.semantic_objects.find((item: { kind: string; identity: string }) => item.kind === 'term' && item.identity === '配置回归测试词');
  assert.deepEqual(projectedTerm?.projection_of, { collection: 'terms', key: 'term', value: '配置回归测试词' });
  assert.equal(projectedTerm?.source_id, config.tables[0].name);
  await page.locator('[data-panel="tables"]').click();
  await page.locator('[data-edit="0"]').waitFor();
  await page.screenshot({ path: join(output, 'tables-desktop.png'), fullPage: true });
  await page.locator('[data-edit="0"]').click();
  await page.locator('#editor-form [name=label]').fill(config.tables[0].label || config.tables[0].name);
  const savedTable = page.waitForResponse(r => r.url().endsWith('/api/settings/catalog') && r.request().method() === 'PUT');
  await page.locator('#editor-form button[type=submit]').click();
  const tableResponse = await savedTable;
  assert.equal(tableResponse.status(), 200, await tableResponse.text());
  await page.locator('#editor-dialog').waitFor({ state: 'hidden' });
  await page.locator('[data-panel="connection"]').click();
  await page.locator('#connection-form').waitFor();
  const tested = page.waitForResponse(r => r.url().endsWith('/api/settings/connection/test'));
  await page.locator('#test-connection').click(); assert.equal((await tested).status(), 200);
  const oldPackage = agent.skill.contentHash;
  const savedConnection = page.waitForResponse(r => r.url().endsWith('/api/settings/connection') && r.request().method() === 'PUT');
  await page.locator('#connection-form button[type=submit]').click();
  const connectionResponse = await savedConnection; assert.equal(connectionResponse.status(), 200, await connectionResponse.text());
  await page.waitForFunction(() => document.querySelector('#feedback')?.textContent?.includes('连接已保存'));
  assert.notEqual(agent.skill.contentHash, oldPackage, 'connection save refreshes the immutable Skill package');
  await page.screenshot({ path: join(output, 'connection-desktop.png'), fullPage: true });
  for (const panel of ['connection', 'model', 'tables']) {
    await page.setViewportSize({ width: 390, height: 844 });
    await page.locator(`[data-panel="${panel}"]`).click();
    await page.waitForFunction(() => document.querySelector('#knowledge-panel')?.getAttribute('aria-busy') === 'false');
    assert.equal(await page.evaluate(() => document.documentElement.scrollWidth <= innerWidth), true, `${panel} mobile overflow`);
    await page.screenshot({ path: join(output, `${panel}-mobile.png`), fullPage: true });
  }
  // Real source configuration is untouched throughout the write tests.
  assert.equal((await originalSettings.catalog('load')).revision, revision);
  assert.deepEqual(errors, []);
  console.log('PASS: all 12 knowledge panels, grouped semantic layers, real TiDB saves, Skill readback, model save, stale-version rejection, connection/package refresh, reload and mobile layouts.');
  console.log('Screenshots:', output);
} finally {
  await browser?.close();
  server?.closeAllConnections(); server?.close();
  await agent?.close();
  await admin.query(`DROP DATABASE IF EXISTS \`${schema}\``);
  await admin.end();
  await removeSkillPackage(join(root, 'files/skill-packages'));
  await rm(root, { recursive: true, force: true });
}
