{
  "name": "agentloop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "npm run build --prefix web",
    "dev": "node scripts/dev.mjs",
    "start": "node --env-file-if-exists=.env src/app.ts",
    "test": "node --test --test-isolation=process tests/*.test.ts",
    "test:coverage": "node --test --experimental-test-coverage --test-isolation=process tests/*.test.ts"
  },
  "dependencies": {
    "docx": "^9.7.1",
    "pptxgenjs": "^4.0.1"
  }
}
