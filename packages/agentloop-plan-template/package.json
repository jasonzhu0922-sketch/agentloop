{
  "name": "@zhujun/agentloop-plan-template",
  "version": "0.1.0",
  "description": "Optional Plan Template planning extension for AgentLoop",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "agentloop-plan-template": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "mine": "node src/cli.ts mine",
    "templates": "node src/cli.ts",
    "test": "node --test --test-isolation=process tests/*.test.ts"
  },
  "dependencies": {
    "@zhujun/agentloop": "*"
  },
  "peerDependencies": {
    "pg": "^8.16.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "typescript": "^7.0.2"
  }
}
