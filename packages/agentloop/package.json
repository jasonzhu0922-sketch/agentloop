  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.0",
    "typescript": "^7.0.2"
  }
}
